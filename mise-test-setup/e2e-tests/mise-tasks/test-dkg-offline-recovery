#!/usr/bin/env -S uv run --script
#MISE description="DKG e2e: DKG fails below threshold, then succeeds once a third keyper comes online"

import os

from e2e_utils import utils, wait_for_dkg_failure, wait_for_dkg_success


# A 3-of-4 keyper set where only keypers 0 and 1 start. Below threshold => DKG
# must fail at least once; bringing keyper-2 online must then trigger a retry
# that succeeds.
os.environ["NUM_KEYPERS"] = "4"
os.environ["INITIAL_KEYPER_SET_INDICES"] = "0,1,2,3"
os.environ["INITIAL_THRESHOLD"] = "3"


utils.run(["mise", "run", "clean"])

# Run the infrastructure setup that `up` would normally chain to, but skip
# `up` itself so we can start keyper-2 and keyper-3 selectively below.
utils.run(["mise", "run", "patch-genesis"])
utils.run(["mise", "run", "init-keyper-dbs"])

# Every service except keyper-2 and keyper-3. Chain nodes for all 4 keypers
# come up so the two offline keypers' shuttermint history is available later.
services = [
    "db",
    "ethereum",
    "chain-seed",
    "bootnode",
    "chain-0",
    "chain-1",
    "chain-2",
    "chain-3",
    "keyper-0",
    "keyper-1",
]
utils.run(["docker", "compose", "up", "-d", *services])
utils.wait_for_service_health("ethereum")
utils.wait_for_service_health("db")
utils.wait_for_service_health("chain-seed")
for index in range(4):
    utils.wait_for_service_health(f"chain-{index}")

utils.run(["mise", "run", "add-initial-keyper-set"])

# With only 2 of 3 required keypers online, the first DKG round must fail.
wait_for_dkg_failure()

# Bring keyper-2 online to reach threshold; the keyper logic retries DKG.
utils.run(["docker", "compose", "up", "-d", "keyper-2"])

wait_for_dkg_success()

utils.run(["mise", "run", "test-decryption"])

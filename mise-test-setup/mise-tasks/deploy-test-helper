#!/usr/bin/env -S uv run --script
#MISE description="Deploy EventTriggerTestHelper (idempotent, address cached in DATA_DIR)"
#MISE depends=["deploy"]

import json
import os
from pathlib import Path

import utils

RPC = "http://127.0.0.1:8545"

data_dir = Path(os.environ["DATA_DIR"])
addr_path = data_dir / "test-helper-addr.json"

if addr_path.exists():
    addr = json.loads(addr_path.read_text())["address"]
    print(f"EventTriggerTestHelper already deployed at {addr}")
    raise SystemExit(0)

artifact = json.loads(
    (
        data_dir
        / "contracts"
        / "out"
        / "EventTriggerTestHelper.sol"
        / "EventTriggerTestHelper.json"
    ).read_text()
)
bytecode_hex = artifact["bytecode"]["object"].removeprefix("0x")

result = utils.run(
    [
        "docker",
        "compose",
        "exec",
        "-T",
        "ethereum",
        "cast",
        "send",
        "--json",
        "--rpc-url",
        RPC,
        "--private-key",
        os.environ["DEPLOY_KEY"],
        "--create",
        bytecode_hex,
    ],
    capture_output=True,
)
receipt = json.loads(result.stdout.strip())
addr = receipt.get("contractAddress") or receipt.get("creates")
if not addr:
    raise SystemExit(
        f"Could not find contractAddress in receipt:\n{json.dumps(receipt, indent=2)}"
    )

addr_path.write_text(json.dumps({"address": addr}))
print(f"EventTriggerTestHelper deployed at {addr}")

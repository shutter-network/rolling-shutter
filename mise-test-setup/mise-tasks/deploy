#!/usr/bin/env -S uv run --script
#MISE description="Deploy contracts if not already deployed"
#MISE depends=["up-ethereum"]

import json
import os
from pathlib import Path

import utils

RPC = "http://127.0.0.1:8545"

REQUIRED_CONTRACTS: dict[str, list[str]] = {
    "gnosis": [
        "KeyBroadcastContract",
        "KeyperSetManager",
        "Sequencer",
        "ValidatorRegistry",
    ],
    "service": ["KeyBroadcastContract", "KeyperSetManager", "ShutterRegistry"],
}


def deployment_is_complete(path: Path, deployment_type: str) -> bool:
    try:
        deployment_run = json.loads(path.read_text())
    except FileNotFoundError:
        return False

    for contract_name in REQUIRED_CONTRACTS[deployment_type]:
        if not utils.get_created_contract_address(deployment_run, contract_name):
            return False
    return True


def deploy_test_helper(data_dir: Path) -> None:
    addr_path = data_dir / "test-helper-addr.json"
    if addr_path.exists():
        addr = json.loads(addr_path.read_text())["address"]
        print(f"EventTriggerTestHelper already deployed at {addr}")
        return

    artifact = json.loads(
        (
            data_dir
            / "contracts"
            / "out"
            / "EventTriggerTestHelper.sol"
            / "EventTriggerTestHelper.json"
        ).read_text()
    )
    bytecode_hex = artifact["bytecode"]["object"].removeprefix("0x")

    result = utils.run(
        [
            "docker",
            "compose",
            "exec",
            "-T",
            "ethereum",
            "cast",
            "send",
            "--json",
            "--rpc-url",
            RPC,
            "--private-key",
            os.environ["DEPLOY_KEY"],
            "--create",
            bytecode_hex,
        ],
        capture_output=True,
    )
    receipt = json.loads(result.stdout.strip())
    addr = receipt.get("contractAddress") or receipt.get("creates")
    if not addr:
        raise SystemExit(
            f"Could not find contractAddress in receipt:\n{json.dumps(receipt, indent=2)}"
        )

    addr_path.write_text(json.dumps({"address": addr}))
    print(f"EventTriggerTestHelper deployed at {addr}")


deployment_type = utils.resolve_deployment_type(os.environ.get("DEPLOYMENT_TYPE", ""))

deploy_script = utils.DEPLOYMENT_SCRIPTS[deployment_type]
data_dir = Path(os.environ["DATA_DIR"])
chain_id = os.environ["ETHEREUM_CHAIN_ID"]
run_path = data_dir / "contracts" / "broadcast" / deploy_script / chain_id / "run-latest.json"

if deployment_is_complete(run_path, deployment_type):
    print(f"Deployment already present at {run_path}; skipping")
else:
    utils.run(
        [
            "docker",
            "compose",
            "run",
            "--rm",
            "--env",
            f"DEPLOY_KEY={os.environ['DEPLOY_KEY']}",
            "contracts",
            "script",
            f"/app/script/{deploy_script}:Deploy",
            "--broadcast",
        ]
    )

if deployment_type == "service":
    deploy_test_helper(data_dir)

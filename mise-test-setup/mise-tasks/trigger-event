#!/usr/bin/env -S uv run --script
# fmt: off
#MISE description="Fire an EventTriggerTestHelper Trigger event on-chain"
#MISE depends=["deploy"]
#USAGE flag "--topic2 <topic2>" help="32-byte topic2 value hex (random if omitted)"
#USAGE flag "--helper-addr <helper_addr>" help="EventTriggerTestHelper address (defaults to deployed address)"
# fmt: on

import json
import os
import secrets
from pathlib import Path

import utils

RPC = "http://127.0.0.1:8545"

deployment_type = utils.resolve_deployment_type(os.environ.get("DEPLOYMENT_TYPE", ""))
if deployment_type != "service":
    raise SystemExit("trigger-event only supports DEPLOYMENT_TYPE=service")

data_dir = Path(os.environ["DATA_DIR"])

helper_addr = os.environ.get("usage_helper_addr", "").strip()
if not helper_addr:
    addr_path = data_dir / "test-helper-addr.json"
    if not addr_path.exists():
        raise SystemExit(
            "No --helper-addr given and EventTriggerTestHelper not deployed "
            "(run: mise run deploy)"
        )
    helper_addr = json.loads(addr_path.read_text())["address"]

topic2_str = os.environ.get("usage_topic2", "").strip()
if not topic2_str:
    topic2_str = secrets.token_hex(32)
topic2_str = topic2_str.removeprefix("0x")
if len(bytes.fromhex(topic2_str)) != 32:
    raise SystemExit("--topic2 must be exactly 32 bytes (64 hex chars)")

zero32 = "0x" + "0" * 64

utils.run(
    [
        "docker",
        "compose",
        "exec",
        "-T",
        "ethereum",
        "cast",
        "send",
        "--rpc-url",
        RPC,
        "--private-key",
        os.environ["DEPLOY_KEY"],
        helper_addr,
        "trigger(uint64,bytes32,bytes32,bytes32)",
        "0",
        f"0x{topic2_str}",
        zero32,
        zero32,
    ],
)

print(f"Fired Trigger event: topic2=0x{topic2_str}")

#!/usr/bin/env -S uv run --script
# fmt: off
#MISE description="Wait for a decryption key generated from an event-based trigger"
#USAGE flag "--keyper-config-index <keyper_config_index>" help="Keyper config index"
#USAGE flag "--identity-prefix <identity_prefix>" help="32-byte identity prefix hex"
# fmt: on

import os
import time

import utils

keyper_config_index_str = os.environ.get("usage_keyper_config_index", "").strip()
identity_prefix = os.environ.get("usage_identity_prefix", "").strip()
if not keyper_config_index_str or not identity_prefix:
    raise SystemExit("Provide both --keyper-config-index and --identity-prefix")

keyper_config_index = int(keyper_config_index_str)
identity_prefix = identity_prefix.removeprefix("0x")
poll_interval = float(os.environ.get("DECRYPTION_KEY_POLL_INTERVAL", "1"))

deadline = time.time() + float(os.environ.get("DECRYPTION_KEY_TIMEOUT", "120"))
while True:
    if time.time() > deadline:
        raise SystemExit(
            f"Timeout waiting for decryption key: "
            f"keyper_config_index={keyper_config_index}, "
            f"identity_prefix={identity_prefix}"
        )

    identity = utils.query_keyper_db(
        0,
        f"SELECT encode(identity, 'hex') FROM event_trigger_registered_event "
        f"WHERE eon = {keyper_config_index} "
        f"AND encode(identity_prefix, 'hex') = '{identity_prefix}' "
        "LIMIT 1",
    )
    if not identity:
        time.sleep(poll_interval)
        continue

    exists = utils.query_keyper_db(
        0,
        "SELECT EXISTS ("
        "  SELECT 1 FROM decryption_key "
        f" WHERE eon = {keyper_config_index} "
        f" AND encode(epoch_id, 'hex') = '{identity}'"
        ")",
    )
    if exists == "t":
        print(
            f"Decryption key ready: "
            f"identity_prefix={identity_prefix} → epoch_id={identity}"
        )
        raise SystemExit(0)

    time.sleep(poll_interval)
